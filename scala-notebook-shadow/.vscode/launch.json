{
  "version": "0.2.0",
  "configurations": [
    {
      // Opens the repo's fixture workspace in the host window, which is where the
      // acceptance checklist in the repository README starts.
      "name": "Run Extension (fixture workspace)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../fixture"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    },
    {
      // Same, but with no folder open, for trying the extension against your own notebook.
      "name": "Run Extension (empty workspace)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
